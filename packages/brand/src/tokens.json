{
  "colors": {
    "oat": "#f6f3ec",
    "paper": "#fffdf8",
    "ink": "#1b2421",
    "muted": "#5c6661",
    "line": "#dcd6ca",
    "moss": "#2f6b4f",
    "moss-deep": "#24563f",
    "moss-tint": "#e3ece5",
    "night": "#263a6b",
    "night-tint": "#e4e7f0",
    "sun": "#f2c14e",
    "skin": "#b9825e",
    "clay": "#7a2e1f",
    "clay-tint": "#f7e4df"
  },
  "fonts": {
    "display": {
      "family": "Fraunces",
      "variable": "--font-fraunces",
      "fallback": "ui-serif, Georgia, serif"
    },
    "sans": {
      "family": "Instrument Sans",
      "variable": "--font-instrument",
      "fallback": "ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "family": "Geist Mono",
      "variable": "--font-geist-mono",
      "fallback": "ui-monospace, monospace"
    }
  },
  "typography": {
    "caption": { "size": 14, "lineHeight": 21.6 },
    "body": { "size": 16, "lineHeight": 25.6 },
    "lead": { "size": 18, "lineHeight": 28 },
    "title": { "min": 22, "max": 24, "preferred": { "base": 20, "vw": 0.5 }, "lineHeight": 1.33 },
    "headline": { "min": 28, "max": 32, "preferred": { "base": 23.2, "vw": 1.2 }, "lineHeight": 1.2 },
    "display-sm": { "min": 36, "max": 44, "preferred": { "base": 28, "vw": 2 }, "lineHeight": 1.09 },
    "display": { "min": 44, "max": 60, "preferred": { "base": 32, "vw": 3 }, "lineHeight": 1.07 }
  },
  "spacing": { "unit": 4, "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 32, "xxl": 48 },
  "radii": { "card": 20, "pill": 999 },
  "layout": {
    "headerHeight": 64,
    "contentWidth": 1440,
    "gutter": { "min": 16, "vw": 4, "max": 64 },
    "tapTarget": 44,
    "primaryAction": 48,
    "inputFontSize": 16,
    "focusWidth": 2,
    "focusOffset": 3,
    "focusRadius": 6
  },
  "motion": {
    "durationMs": { "press": 150, "exit": 120, "panel": 200, "response": 280, "step": 350, "reveal": 480 },
    "ease": { "settle": [0.22, 1, 0.36, 1] }
  }
}
