{
  "expo": {
    "name": "Rhythm",
    "slug": "rhythm-health-lab",
    "scheme": "rhythm",
    "icon": "./assets/icon.png",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f6f3ec",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#10161f"
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f6f3ec"
      }
    }
  }
}
