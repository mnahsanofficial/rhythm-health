{
  "name": "rhythm-health",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=rhythm-health-frontend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run contract:check && npm test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=rhythm-health-frontend",
    "build": "npm run build --workspace=rhythm-health-frontend",
    "contract:generate": "npm run generate --workspace=@rhythm-health/contract",
    "contract:check": "npm run check --workspace=@rhythm-health/contract"
  }
}
