# Copy to .env.local (gitignored). Never commit real values.
NEXT_PUBLIC_API_URL=http://localhost:8001
# Supabase project URL and the public anon key (never the service-role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Blank means no error reporting. Public by design, like the anon key.
NEXT_PUBLIC_SENTRY_DSN=

# Same web project DSN for server-side errors (optional).
SENTRY_DSN=
APP_ENVIRONMENT=development
NEXT_PUBLIC_APP_ENVIRONMENT=development
DEV_FAILURE_DRILL=0
