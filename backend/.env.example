# Copy to .env.local (gitignored). Never commit real values.
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Backend-only. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Optional; defaults to $SUPABASE_URL/auth/v1
SUPABASE_JWT_ISSUER=

# OpenRouter: one shared client for the reasoning model and Jev.
OPENROUTER_API_KEY=
# Blank falls back to anthropic/claude-sonnet-5.5
OPENROUTER_REASONING_MODEL=
# Blank falls back to typesafe/jev-router
OPENROUTER_JEV_MODEL=
